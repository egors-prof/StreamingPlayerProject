# Скопируйте в .env и задайте свои значения:  cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).

POSTGRES_PASSWORD=change-me-postgres-password

# Секрет подписи JWT, не короче 32 символов. Сгенерировать:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# true, если приложение открыто по HTTPS (в продакшене — всегда).
COOKIE_SECURE=false

# Сколько треков сервер стримит одновременно; остальные получают 503.
STREAM_MAX_CONCURRENT=50

LOG_LEVEL=info
